# cp env.example .env 后填真实值（compose自动读取）
DB_PASSWORD=change-me-strong
API_TOKEN=change-me-bearer-token-for-admin   # 留空=开发模式无鉴权(仅限本机)
NODE_SHARED_SECRET=change-me-node-join-secret
DUBBING_BASIC_USER=ops
DUBBING_BASIC_PASSWORD_HASH=$2a$14$xxxxx   # caddy password-hash工具生成
ENCRYPTION_KEY=change-me-aes-key           # provider key加密
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=dubbing
