# Copy to deploy/.env on the server. Keep this file out of Git.
ENCRYPTION_KEY=replace-with-a-long-random-value
NODE_SHARED_SECRET=replace-with-a-different-long-random-value
NODE_ARTIFACT_MAX_MB=256
# Optional Cloudflare R2. Leave blank for local/mock upload mode.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=dubbing
# Optional build mirrors for regions where upstream package hosts are slow.
# APT_MIRROR=https://mirrors.tencentyun.com
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
